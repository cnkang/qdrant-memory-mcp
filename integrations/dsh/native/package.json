{
  "name": "@cnkang/qdrant-memory-dsh-native",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Opt-in DeepSeek Harness native lifecycle adapter for the existing Qdrant Memory Python Runtime",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "README.zh-CN.md",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "pretest": "npm run validate:node",
    "test": "node --test",
    "validate:node": "node ./scripts/validate-node.mjs",
    "validate:dsh": "node ./scripts/validate-dsh.mjs",
    "validate:host": "node ./scripts/validate-host.mjs"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "overrides": {
    "zod": "4.6.7"
  },
  "peerDependencies": {"@deepseek-ai/dsh-session": "0.2.2-rc.1"},
  "peerDependenciesMeta": {"@deepseek-ai/dsh-session": {"optional": true}},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
