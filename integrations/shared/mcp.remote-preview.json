{
  "mcpServers": {
    "qdrant-memory-owner": {
      "type": "stdio",
      "command": "/absolute/path/reviewed-runtime/bin/qdrant-memory",
      "args": ["remote-mcp", "--url", "https://memory.example.com/mcp"],
      "env": {"QDRANT_MEMORY_REMOTE_TOKEN": "${QDRANT_MEMORY_REMOTE_TOKEN}"}
    }
  }
}
